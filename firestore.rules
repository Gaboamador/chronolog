rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function hasCompleteProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.firstName is string
        && get(/databases/$(database)/documents/users/$(userId)).data.firstName.size() > 0
        && get(/databases/$(database)/documents/users/$(userId)).data.lastName is string
        && get(/databases/$(database)/documents/users/$(userId)).data.lastName.size() > 0;
    }

    // El usuario siempre puede leer/escribir su propio perfil.
    // Esto es necesario para que alguien sin nombre pueda justamente completarlo.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Datos del usuario: entries y cualquier otra subcolección equivalente.
    match /users/{userId}/{collection}/{docId} {
      allow read: if isOwner(userId);

      allow write: if isOwner(userId)
        && hasCompleteProfile(userId);
    }
  }
}