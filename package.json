{
  "name": "chronolog",
  "version": "0.1.0",
  "homepage": "https://gaboamador.github.io/chronolog",
  "private": true,
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^11.7.3",
    "framer-motion": "^12.40.0",
    "react": "^19.1.0",
    "react-calendar": "^5.1.0",
    "react-day-picker": "^9.6.7",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.5.2",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "zxcvbn": "^4.4.2"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:lan": "vite --mode development --host 0.0.0.0",
    "start": "vite --mode development",
    "build": "vite build --mode production",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "preview": "vite preview --mode production",
    "test:firebase-env": "node --test tests/firebaseEnvironment.test.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:rules:dev": "firebase deploy --only firestore:rules --project chronolog-dev",
    "deploy:rules:prod": "firebase deploy --only firestore:rules --project chronolog-f21f6"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "sass": "^1.87.0",
    "sass-loader": "^13.3.3",
    "vite": "^8.0.14"
  }
}
